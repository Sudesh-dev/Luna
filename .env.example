# Optional cloud accounts and playlists. Use only the public publishable key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Jamendo requires your own free app client ID. The suggested 56d30c95 ID is suspended.
EXPO_PUBLIC_JAMENDO_CLIENT_ID=

# Optional public Piped API base URL if the default instance is unavailable.
EXPO_PUBLIC_PIPED_API_BASE_URL=
